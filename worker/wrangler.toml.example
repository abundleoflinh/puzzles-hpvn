name = "hpvn-puzzles-api"
main = "src/index.js"
compatibility_date = "2026-01-01"

# Copy this file to `wrangler.toml` and fill in your KV namespace id from the
# Cloudflare dashboard (Workers & Pages → KV → PUZZLES → copy the ID).
# `wrangler.toml` is gitignored so your real id never lands in the repo.
[[kv_namespaces]]
binding = "PUZZLES"
id = "YOUR_KV_NAMESPACE_ID"

# Editor password is set as a secret, NOT here:
#   cd worker && npx wrangler secret put EDITOR_PASSWORD
# (wrangler will prompt for the value; it's stored encrypted on Cloudflare.)

[observability]
enabled = true
